{
  "name": "courtmate-functions",
  "version": "1.0.0",
  "description": "Trusted Firebase Cloud Functions backend for CourtMate",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "tsc -p tsconfig.test.json && node --test lib-test/test/anmul-module.test.js",
    "test:doku-sandbox": "npm run build && node scripts/test-doku-sandbox.mjs",
    "test:webhook-emulator": "npm run build && node scripts/simulate-doku-webhook.mjs",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "emulators": "npm run build && npx firebase-tools emulators:start --project courtmate-40007 --only auth,firestore,functions",
    "serve": "npm run build && firebase emulators:start --only functions,firestore,auth",
    "deploy": "firebase deploy --only functions"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  },
  "private": true
}
