# Salin nilai MAPS_API_KEY berikut ke file `android/local.properties` (jangan di-commit ke Git):
# MAPS_API_KEY=AIzaSy_GANTI_DENGAN_GOOGLE_MAPS_ANDROID_KEY

# Untuk pengujian lokal Firebase Emulator pada folder `functions/`,
# buat file `functions/.secret.local` dengan isi berikut (jangan di-commit ke Git):
DOKU_CLIENT_ID=BRN-XXXX-XXXXXXXXXXXX
DOKU_SECRET_KEY=SK-XXXXXXXXXXXXXXXXXXXX
